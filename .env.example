# Copy to .env and fill in. .env is gitignored; never commit real values.

# Where the API listens, and the frontend address allowed to call it.
HOST=127.0.0.1
PORT=3013
ORIGIN_URL=http://127.0.0.1:3220

# Postgres connection. The database must already exist; then run
# `npm run db:setup` to create the tables and load the sample data.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=coinsmatter_dev
# The database owner. Only db:setup and the tests' cleanup use it.
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=
# The account the app runs as.
PG_USER=
PG_PASSWORD=

# Signs login sessions. Use a long random value, for example the output of
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
